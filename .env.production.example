# Copy to .env and replace every placeholder. Never commit .env.
APP_NAME=enterprise-ai-gateway
APP_ENV=production
LOG_LEVEL=INFO
OPENAI_API_KEY=REPLACE_WITH_SECRET_MANAGER_INJECTED_KEY
OPENAI_MODEL=REPLACE_WITH_PROVIDER_SUPPORTED_MODEL
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_LONG_RANDOM_REDIS_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS_FROM_SECRET_MANAGER
JWT_ALGORITHM=HS256
JWT_ISSUER=https://your-identity-provider.example/issuer
JWT_AUDIENCE=enterprise-ai-gateway
AUTH_ENABLED=true
ALLOW_INSECURE_LOCAL_AUTH=false
MOCK_PROVIDER_ENABLED=false
DATABASE_URL=postgresql+psycopg://gateway:unused@postgres:5432/gateway
MEMORY_BACKEND=sql
RATE_LIMITER_BACKEND=redis
REDIS_URL=redis://:unused@redis:6379/0
CACHE_ENABLED=true
CACHE_BACKEND=redis
# Keep these three settings aligned. Replace placeholder model IDs and prices using official provider pricing.
ALLOWED_MODELS=REPLACE_WITH_PROVIDER_SUPPORTED_MODEL
BASELINE_MODEL=REPLACE_WITH_PROVIDER_SUPPORTED_MODEL
MODEL_PROFILES_JSON=[{"provider":"openai","model":"REPLACE_WITH_PROVIDER_SUPPORTED_MODEL","quality":0.9,"latency":0.8,"capabilities":["general","reasoning","coding"]}]
MODEL_PRICING_JSON={"REPLACE_WITH_PROVIDER_SUPPORTED_MODEL":{"input_per_1m":0.0,"output_per_1m":0.0,"source":"REPLACE_WITH_OFFICIAL_PRICING_URL","verified_on":"YYYY-MM-DD"}}
DEFAULT_DAILY_BUDGET_USD=10
BUDGET_OUTPUT_ESTIMATE_TOKENS=2000
MAX_OUTPUT_TOKENS=2000
