[4.521, "o", "━━━ Scene 2: Pre-flight cost estimate (no model is called) ━━━━━━━━━━━━━━━━━\r\n"]
[5.227, "o", "  gpt-5.6-sol    ~11 in / 500 out tokens  ->  $0.010044\r\n"]
