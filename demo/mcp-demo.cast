[17.731, "o", "  request 2: ALLOW remaining=$0.000751\r\n"]
[18.118, "o", "  request 3: ALLOW remaining=$0.000718\r\n"]
[18.497, "o", "  request 4: ALLOW remaining=$0.000686\r\n"]
[18.879, "o", "  request 5: ALLOW remaining=$0.000653\r\n"]
[19.267, "o", "  request 6: ALLOW remaining=$0.000621\r\n"]
[19.653, "o", "  request 7: ALLOW remaining=$0.000588\r\n"]
[20.039, "o", "  request 8: BLOCK remaining=$0.000588   reason=BUDGET_EXCEEDED  (provider never called)\r\n"]
