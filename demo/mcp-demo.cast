[5.831, "o", "\r\n"]
[5.831, "o", "━━━ Scene 3: Governed requests: the gateway, not the caller, picks the model ━━\r\n"]
[6.532, "o", "  (Mock mode exposes a single model, so the pick is trivial here; the routing reason shows what drove it.)\r\n"]
[7.226, "o", "  [simple   ] hint=general_fast/cost  ->  mock:mock-general   decision=ALLOW\r\n"]
[7.526, "o", "              reason: task=general_fast;priority=cost;client task hint; client priority hint\r\n"]
[7.865, "o", "  [coding   ] hint=coding/quality  ->  mock:mock-general   decision=ALLOW\r\n"]
[8.165, "o", "              reason: task=coding;priority=quality;client task hint; client priority hint\r\n"]
[8.497, "o", "  [reasoning] hint=reasoning/quality  ->  mock:mock-general   decision=ALLOW\r\n"]
[8.798, "o", "              reason: task=reasoning;priority=quality;client task hint; client priority hint\r\n"]
[9.098, "o", "\r\n"]
[9.098, "o", "━━━ Scene 4: Content security blocks unsafe prompts before any model call ━━\r\n"]
[9.817, "o", "  prompt injection  -> BLOCK  (PROMPT_INJECTION_DETECTED)   model called: no\r\n"]
[10.234, "o", "  secret in prompt  -> BLOCK  (SECRET_DETECTED)   model called: no\r\n"]
[10.634, "o", "\r\n"]
[10.635, "o", "━━━ Scene 5: Tenant isolation: another application cannot read this audit record ━━\r\n"]
[11.342, "o", "  owner (demo-app):       found=True\r\n"]
[11.643, "o", "  other (contract-agent): found=False\r\n"]
[12.043, "o", "\r\n"]
[12.043, "o", "━━━ Scene 6: Least privilege: a plain developer can use the gateway but not read audit or usage ━━\r\n"]
[14.367, "o", "  developer  gateway_check_budget          -> ok (limit $0.0009)\r\n"]
[14.67, "o", "  developer  gateway_get_routing_decision  -> denied (OPERATOR_ROLE_REQUIRED)\r\n"]
[14.973, "o", "  developer  gateway_get_usage             -> denied (OPERATOR_ROLE_REQUIRED)\r\n"]
[15.608, "o", "  operator   gateway_get_usage             -> ok (5 rows returned)\r\n"]
[16.009, "o", "\r\n"]
