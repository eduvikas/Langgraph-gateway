APP_NAME=langgraph-gateway-v2.6
APP_ENV=local
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
MAX_PROMPT_CHARS=20000
MAX_OUTPUT_TOKENS=2000
DATABASE_URL=sqlite:///./gateway.db
MEMORY_BACKEND=sql
RATE_LIMITER_BACKEND=memory
REDIS_URL=redis://localhost:6379/0
AUTH_ENABLED=false
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=
JWT_AUDIENCE=
ALLOW_INSECURE_LOCAL_AUTH=true
BLOCK_SECRETS=true
BLOCK_PROMPT_INJECTION=true
# true = also block the flag-only tier (risky-looking but common phrases). Default false.
INJECTION_STRICT=false

# --- token economics ---
# Savings are measured against this model: the same tokens priced here.
BASELINE_MODEL=gpt-5.6-sol
# Price mock-provider calls as this real model (demos only). Empty = mock is free and unbilled.
MOCK_PRICING_MODEL=
# Daily budget per application in USD, used when the application's policy sets none. 0 = unlimited.
DEFAULT_DAILY_BUDGET_USD=0
BUDGET_OUTPUT_ESTIMATE_TOKENS=500
BUDGET_ALERT_THRESHOLD=0.8
# Exact-match response cache. CACHE_BACKEND: memory or redis (redis uses REDIS_URL).
CACHE_ENABLED=true
CACHE_BACKEND=memory
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=1000
ROUTING_PRIORITY=balanced
ROUTING_TASK=general
MOCK_PROVIDER_ENABLED=true
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_SECONDS=30
EVALUATION_ENABLED=true
EVALUATION_MIN_SCORE=0.65
ALLOWED_APPLICATIONS=demo-app,contract-agent,sre-agent
ALLOWED_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,mock-general

# Optional JSON overrides. Production requires explicit profiles and verified prices; see .env.production.example.
MODEL_PROFILES_JSON=
MODEL_PRICING_JSON=
PRICING_MAX_AGE_DAYS=30
REQUEST_TIMEOUT_SECONDS=60

# --- MCP adapter ---
# stdio is the safest local default. For stdio with AUTH_ENABLED=true, provide a valid
# JWT from your configured identity provider through MCP_GATEWAY_BEARER_TOKEN.
MCP_TRANSPORT=stdio
MCP_GATEWAY_BEARER_TOKEN=
# Explicit local-only convenience; ignored in production and when AUTH_ENABLED=true.
MCP_ALLOW_INSECURE_LOCAL=false
MCP_DEV_USER_ID=
# Roles for the local insecure identity (default: developer). Add ,operator to use the audit/usage tools.
MCP_DEV_ROLES=developer
